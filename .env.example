# =============================================================================
# Salon Queue Management System — Environment Configuration Template
# =============================================================================
# Architecture:
#   - Frontend: Vercel Free
#   - Backend: Vercel Services / Serverless or Persistent Node.js Server
#   - Database: Neon PostgreSQL Free (pg pool with SSL)
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (Node.js / Express / PostgreSQL / Socket.IO) ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# Port where Express listens (default: 5000)
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=development

# Neon PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# If empty or not provided, the application safely falls back to local SQLite WAL for offline development.
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# SQLite database file path (used only when DATABASE_URL is not set)
DB_PATH=./data/salon_queue.sqlite

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated if multiple)
# In development: http://localhost:5173
# In production on Vercel: https://your-salon-frontend.vercel.app
CLIENT_URL=http://localhost:5173,https://your-salon-frontend.vercel.app

# -----------------------------------------------------------------------------
# FRONTEND (React / Vite) ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# Variables starting with VITE_ are embedded into the client bundle at build time.

# Backend API Base URL
# In local development: http://localhost:5000
# In production (Vercel Serverless / Service): https://your-salon-backend.vercel.app or empty if served on same domain
VITE_API_URL=http://localhost:5000

# Backend Socket.IO Server URL
# In local development: http://localhost:5000
# In production: https://your-salon-backend.vercel.app
VITE_SOCKET_URL=http://localhost:5000
