# =============================================================================
# Salon Queue Management System — Environment Configuration Template
# =============================================================================
# Copy this file to:
#   - `.env` in the project root (optional for local monorepo tools)
#   - `server/.env` (for backend execution)
#   - `client/.env` (for frontend Vite build)
#
# NOTE: Never commit your actual .env file or production secrets to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (Node.js / Express / Socket.IO) ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# Port where Express listens (Render automatically assigns PORT)
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=development

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated if multiple)
# In development: http://localhost:5173
# In production: https://your-salon-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# SQLite database file path
# In local development: ./data/salon_queue.sqlite
# In production on Render (with Persistent Disk mounted): /var/data/salon_queue.sqlite
DB_PATH=./data/salon_queue.sqlite


# -----------------------------------------------------------------------------
# FRONTEND (React / Vite) ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# Variables starting with VITE_ are embedded into the client bundle at build time.

# Backend API Base URL
# In local development: leave empty to use Vite proxy (/api), or http://localhost:5000
# In production (Vercel): https://your-salon-server.onrender.com
VITE_API_URL=http://localhost:5000

# Backend Socket.IO Server URL
# In local development: http://localhost:5000
# In production (Vercel): https://your-salon-server.onrender.com
VITE_SOCKET_URL=http://localhost:5000
